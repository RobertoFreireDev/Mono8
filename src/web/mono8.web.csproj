<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The browser build of the console. Same engine, same game, same authored data — only the
       backend and the host differ: KNI (github.com/kniEngine/kni) in place of MonoGame.DesktopGL,
       and a Blazor WebAssembly page in place of Program.cs. -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Match mono8.csproj: honour nullable annotations without turning on nullable warnings. -->
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>mono8.web</RootNamespace>
    <AssemblyName>mono8.web</AssemblyName>
    <!-- What the shared sources branch on wherever the browser has no equivalent of a desktop:
         no window to move, nothing to exit to, and no disk that survives a reload. -->
    <DefineConstants>$(DefineConstants);BLAZORGL</DefineConstants>
    <KniPlatform>BlazorGL</KniPlatform>
  </PropertyGroup>

  <PropertyGroup>
    <!-- stat(1)-stat(6) are the local wall clock, so the time zone data has to ship: without it
         DateTime.Now in the browser is UTC and the console would quietly report the wrong hour. -->
    <BlazorEnableTimeZoneSupport>true</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <!-- The gate. A web build is a published build by definition — the editors have no place in a
       browser, and every asset the game reads is the embedded copy below, which the console only
       looks for when PublishGame is set. The flag is read straight out of the source, the same way
       mono8.csproj reads it, so there is never a second copy of it to keep in step. -->
  <PropertyGroup>
    <Mono8PublishGame>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../Mono8API.cs')), 'PublishGame\s*=\s*true'))</Mono8PublishGame>
  </PropertyGroup>
  <Target Name="RequireMono8PublishGame" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Mono8PublishGame)' != 'True'"
           Text="Mono8API.PublishGame is false, so there is no web build to make. Set it to true in src/Mono8API.cs, save once in the editors so src/publishdata is up to date, then build this project again." />
  </Target>

  <ItemGroup>
    <!-- One codebase. Program.cs is the desktop entry point; the browser's is web/Program.cs. -->
    <Compile Include="..\*.cs" Exclude="..\Program.cs" />
    <Compile Include="..\core\**\*.cs" />
    <Compile Include="..\editor\**\*.cs" />
    <Compile Include="..\game\**\*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Pages\Index.razor.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the editors mirrored on the last save. data.save is dset's runtime file; in the browser
         it is a localStorage key rather than a resource, so it is never embedded. -->
    <Mono8Mirrored Include="..\publishdata\*" Exclude="..\publishdata\*.save" />
    <EmbeddedResource Include="@(Mono8Mirrored)">
      <LogicalName>publishdata/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- A browser build has no folder beside the executable to fall back to, so anything the mirror
         does not carry yet — the font and the icon sheet, before the developer's first save — comes
         off the runtime data folder instead. publishdata wins wherever both hold the same file. -->
    <_Mono8MirroredName Include="@(Mono8Mirrored->'%(Filename)%(Extension)')" />
    <_Mono8RuntimeData Include="..\data\*" Exclude="..\data\*.save" />
    <_Mono8MissingName Include="@(_Mono8RuntimeData->'%(Filename)%(Extension)')" Exclude="@(_Mono8MirroredName)" />
    <EmbeddedResource Include="@(_Mono8MissingName->'..\data\%(Identity)')">
      <LogicalName>publishdata/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.2.9001.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.17" PrivateAssets="all" />
  </ItemGroup>

</Project>
